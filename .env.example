# This file documents only the Clerk customer-auth contract added in
# Phase 3A.3A. It is not a complete list of this project's environment
# variables (DATABASE_URL, APP_ENV, operator-only bootstrap, BLOB_*, etc. are
# provisioned separately and are intentionally not enumerated here).
# Never commit real values to this file.

# Clerk (customer auth) — required for the /account zone.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PayTR (Phase 3.3B prep) — server-side only, never NEXT_PUBLIC_. Online
# payment stays OFF unless PAYTR_ENABLED is exactly "true"; test mode stays
# ON unless PAYTR_TEST_MODE is exactly "false". Key and salt are secrets:
# set them only in the hosting provider's encrypted env, never here.
PAYTR_ENABLED=false
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_OK_URL=
PAYTR_FAIL_URL=
PAYTR_IFRAME_V2=true
